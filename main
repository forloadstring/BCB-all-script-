--========================================================
-- FARM VARIABLES
--========================================================
local farming = false
local allFarming = false
local selectedLoops = nil
local currentLoop = 0

--========================================================
-- TELEPORT
--========================================================
local function teleportTo(position)
    local character = player.Character
    if not character then return end
    local root = character:FindFirstChild("HumanoidRootPart")
    if root then
        root.CFrame = CFrame.new(position)
    end
end

--========================================================
-- STOP FARM
--========================================================
local function stopFarm(message)
    farming = false
    allFarming = false
    selectedLoops = nil
    currentLoop = 0
    farm.Text = "AUTO FARM • OFF"
    farm.BackgroundColor3 = BUTTON
    allFarm.Text = "AUTO FARM ALL MAP • OFF"
    allFarm.BackgroundColor3 = BUTTON
    status.Text = message or "READY"
    statusDot.BackgroundColor3 = GREEN
end

