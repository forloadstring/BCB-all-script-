local selectedMaps = {}

for _, name in ipairs(MAP_NAMES) do
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(0.9,0,0,28)
    btn.BackgroundColor3 = BUTTON
    btn.BorderSizePixel = 0
    btn.Text = name
    btn.TextColor3 = WHITE
    btn.TextSize = 12
    btn.Font = Enum.Font.GothamBold
    btn.AutoButtonColor = false
    btn.Parent = mapScroll
    corner(btn,8)
    stroke(btn,BLUE,.5,1)
    
    btn.MouseButton1Click:Connect(function()
        local isSelected = false
        for i, v in ipairs(selectedMaps) do
            if v == name then
                table.remove(selectedMaps, i)
                isSelected = true
                break
            end
        end
        if not isSelected then
            table.insert(selectedMaps, name)
        end
        if not isSelected then
            btn.BackgroundColor3 = GREEN
            stroke(btn,GREEN,0,1.5)
        else
            btn.BackgroundColor3 = BUTTON
            stroke(btn,BLUE,.5,1)
        end
        if #selectedMaps == 0 then
            selectedInfo.Text = "SELECTED: NONE"
            selectedInfo.TextColor3 = GRAY
        else
            selectedInfo.Text = "SELECTED: " .. table.concat(selectedMaps, ", ")
            selectedInfo.TextColor3 = CYAN
        end
    end)
end

