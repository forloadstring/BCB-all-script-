local choices = {
    {"1x",1},
    {"5x",5},
    {"10x",10},
    {"25x",25},
    {"50x",50},
    {"∞ UNLIMITED",math.huge},
}

for i,data in ipairs(choices) do
    local col = (i-1)%3
    local row = math.floor((i-1)/3)
    local b = button(
        farmPanel,
        data[1],
        UDim2.fromOffset(100,55),
        UDim2.fromOffset(15+col*115,88+row*65)
    )
    b.ZIndex = 101
    b.Activated:Connect(function()
        selectedLoops = data[2]
        currentLoop = 0
        farming = true
        allFarming = false
        farmPanel.Visible = false
        farm.Text = "AUTO FARM • ON"
        farm.BackgroundColor3 = GREEN
        allFarm.BackgroundColor3 = BUTTON
        if selectedLoops == math.huge then
            status.Text = "FARMING • ∞ LOOP"
        else
            status.Text = "FARMING • 0/"..selectedLoops
        end
    end)
end

--========================================================
-- NORMAL AUTO FARM
--========================================================
farm.Activated:Connect(function()
    if farming or allFarming then
        stopFarm("READY")
        return
    end
    if #selectedMaps == 0 then
        status.Text = "⚠️ マップが選択されていません"
        return
    end
    farmPanel.Visible = true
end)

task.spawn(function()
    while gui.Parent do
        if farming and selectedLoops then
            local totalLoops = selectedLoops
            local loopCount = 0
            while farming and (totalLoops == math.huge or loopCount < totalLoops) do
                loopCount = loopCount + 1
                for _, mapName in ipairs(selectedMaps) do
                    if not farming then break end
                    local points = MAPS[mapName]
                    if not points or #points == 0 then
                        status.Text = "⚠️ " .. mapName .. " の座標がありません"
                        break
                    end
                    for i, position in ipairs(points) do
                        if not farming then break end
                        status.Text = "LOOP "..loopCount.."/"..(totalLoops == math.huge and "∞" or tostring(totalLoops)).." • "..mapName.." "..i.."/"..#points
                        teleportTo(position)
                        task.wait(WAYPOINT_DELAY)
                    end
                end
            end
            if farming then
                stopFarm("FARM COMPLETE ✓")
                task.wait(1)
                status.Text = "READY"
            end
        else
            task.wait(.15)
        end
    end
end)

--========================================================
-- AUTO FARM ALL MAP
--========================================================
local function farmAllMaps()
    allFarming = true
    farming = false
    selectedLoops = nil
    allFarm.Text = "AUTO FARM ALL MAP • ON"
    allFarm.BackgroundColor3 = GREEN
    farm.BackgroundColor3 = BUTTON

    for mapIndex,mapName in ipairs(MAP_NAMES) do
        if not allFarming then break end
        local points = MAPS[mapName]
        if points then
            status.Text = "ALL MAP • "..mapIndex.."/"..#MAP_NAMES.." • "..mapName
            for waypoint,position in ipairs(points) do
                if not allFarming then break end
                status.Text = mapName.." • "..waypoint.."/"..#points
                teleportTo(position)
                task.wait(WAYPOINT_DELAY)
            end
        end
    end

    if allFarming then
        statusDot.BackgroundColor3 = CYAN
        status.Text = "ALL MAP COMPLETE ✓ • WAIT 10 MINUTES"
        task.wait(ALL_MAP_WAIT)
    end
    if allFarming then
        stopFarm("ALL MAP READY")
    end
end

allFarm.Activated:Connect(function()
    if allFarming or farming then
        stopFarm("ALL MAP STOPPED")
        return
    end
    task.spawn(farmAllMaps)
end)

--========================================================
-- AUTO INTERACT
--========================================================
local autoInteract = false

interact.Activated:Connect(function()
    autoInteract = not autoInteract
    if autoInteract then
        interact.Text = "AUTO INTERACT • ON"
        interact.BackgroundColor3 = GREEN
        status.Text = "AUTO INTERACT • ACTIVE"
        statusDot.BackgroundColor3 = GREEN
    else
        interact.Text = "AUTO INTERACT • OFF"
        interact.BackgroundColor3 = BUTTON
        status.Text = "READY"
    end
end)

local promptConnection
promptConnection = ProximityPromptService.PromptShown:Connect(function(prompt)
    if not autoInteract then return end
    if prompt and prompt:IsA("ProximityPrompt") then
        pcall(function()
            if typeof(fireproximityprompt) == "function" then
                fireproximityprompt(prompt)
            end
        end)
    end
end)

task.spawn(function()
    while gui.Parent do
        if autoInteract then
            local character = player.Character
            if character then
                local root = character:FindFirstChild("HumanoidRootPart")
                if root then
                    for _,obj in ipairs(workspace:GetDescendants()) do
                        if obj:IsA("ProximityPrompt") then
                            local holder = obj.Parent
                            if holder then
                                local part
                                if holder:IsA("BasePart") then
                                    part = holder
                                elseif holder:IsA("Attachment") then
                                    part = holder.Parent
                                end
                                if part and part:IsA("BasePart") then
                                    local distance = (part.Position-root.Position).Magnitude
                                    if distance <= obj.MaxActivationDistance then
                                        pcall(function()
                                            if typeof(fireproximityprompt) == "function" then
                                                fireproximityprompt(obj)
                                            end
                                        end)
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end
        task.wait(.25)
    end
end)

--========================================================
-- MINIMIZE SLEEPY
--========================================================
local minimized = false

minimize.Activated:Connect(function()
    minimized = not minimized
    if minimized then
        content.Visible = false
        main.Size = UDim2.fromOffset(390,82)
        minimize.Text = "+"
    else
        content.Visible = true
        main.Size = UDim2.fromOffset(390,590)
        minimize.Text = "−"
    end
end)

--========================================================
-- 共通実行（Brainrot + 透明化 + AFK）
--========================================================
task.spawn(function()
    local success, err = pcall(function()
        loadstring(game:HttpGet(('https://gist.githubusercontent.com/NTheDrone-come/c9383f688764c2e7dc68676d6ab26e71/raw/8e67c55142a1f5e5500c012e078d949e2b996056/invisible')))()
    end)
    if not success then
        warn("透明化スクリプト失敗:", err)
    else
        print("✅ 透明化完了")
    end
end)

task.spawn(function()
    local success, err = pcall(function()
        loadstring(game:HttpGet("https://raw.githubusercontent.com/asvraRoblox/brainrot_battle_cards/refs/heads/main/main"))()
    end)
    if success then
        print("✅ Brainrot メイン実行完了")
    else
        warn("❌ Brainrot 失敗:", err)
    end
end)

task.spawn(function()
    local VirtualInputManager = game:GetService("VirtualInputManager")
    print("🔄 AFK回避開始（5分間隔）")
    while task.wait() do
        VirtualInputManager:SendKeyEvent(true, "Space", false, game)
        task.wait(0.2)
        VirtualInputManager:SendKeyEvent(false, "Space", false, game)
        task.wait(300)
    end
end)

--========================================================
-- AUTO PURCHASE (Individual Auto Purchase + AFK)
--========================================================
do
    local playerAP = game.Players.LocalPlayer

    local itemsAP = {
        {remote = "PurchaseBlackMarketItemFunction", name = "Black Market Coins", args = {"Black Market Coins"}},
        {remote = "PurchaseBlackMarketItemFunction", name = "Black Market Crate", args = {"Black Market Crate"}},
        {remote = "PurchaseBlackMarketItemFunction", name = "Skibidi Storm Potion", args = {"Skibidi Storm Potion"}},
        {remote = "PurchaseBlackMarketItemFunction", name = "1000-Roll Pack", args = {"1000-Roll Pack"}},
        {remote = "PurchaseBlackMarketItemFunction", name = "Huge Speed Potion", args = {"Huge Speed Potion"}},
        {remote = "PurchaseBlackMarketItemFunction", name = "Huge Rarity Potion", args = {"Huge Rarity Potion"}},
        {remote = "PurchaseBlackMarketItemFunction", name = "Mega Boss Potion", args = {"Mega Boss Potion"}},
        {remote = "PurchaseBlackMarketItemFunction", name = "Loaded Dice", args = {"Loaded Dice"}},
        {remote = "PurchaseBlackMarketItemFunction", name = "Variant Serum", args = {"Variant Serum"}},
        {remote = "GenieShopPurchaseFunction", name = "Genie Crate", args = {"Genie Crate"}},
        {remote = "GenieShopPurchaseFunction", name = "Cleansing Potion", args = {"Cleansing Potion"}},
        {remote = "GenieShopPurchaseFunction", name = "One More Day", args = {"One More Day"}},
        {remote = "GenieShopPurchaseFunction", name = "Golden Acorn", args = {"Golden Acorn"}},
        {remote = "GenieShopPurchaseFunction", name = "Storm in a Bottle", args = {"Storm in a Bottle"}},
        {remote = "GenieShopPurchaseFunction", name = "Mystery Seed", args = {"Mystery Seed"}},
        {remote = "GenieShopPurchaseFunction", name = "The Wish Tree", args = {"The Wish Tree"}},
    }

    local remotesAP = {}
    for i, item in ipairs(itemsAP) do
        local r = game.ReplicatedStorage:FindFirstChild(item.remote)
        if not r then
            print("❌ Remote not found: " .. item.remote)
            return
        end
        remotesAP[i] = r
    end

    local screenGuiAP = Instance.new("ScreenGui")
    screenGuiAP.Name = "AutoPurchaseGUI"
    screenGuiAP.ResetOnSpawn = false
    screenGuiAP.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    screenGuiAP.DisplayOrder = 998
    screenGuiAP.Parent = playerAP.PlayerGui

    local frameAP = Instance.new("Frame")
    frameAP.Size = UDim2.new(0, 600, 0, 850)
    frameAP.Position = UDim2.new(0.5, -300, 0.5, -425)
    frameAP.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
    frameAP.BackgroundTransparency = 0.1
    frameAP.Active = true
    frameAP.Draggable = true
    frameAP.Parent = screenGuiAP

    local titleAP = Instance.new("TextLabel")
    titleAP.Size = UDim2.new(1, 0, 0, 55)
    titleAP.BackgroundTransparency = 1
    titleAP.Text = "⏱️ Auto Purchase + AFK"
    titleAP.TextColor3 = Color3.fromRGB(255, 255, 255)
    titleAP.TextSize = 30
    titleAP.Font = Enum.Font.GothamBold
    titleAP.Parent = frameAP

    local minimizeBtnAP = Instance.new("TextButton")
    minimizeBtnAP.Size = UDim2.new(0, 50, 0, 45)
    minimizeBtnAP.Position = UDim2.new(0.78, 0, 0.005, 0)
    minimizeBtnAP.BackgroundColor3 = Color3.fromRGB(200, 200, 0)
    minimizeBtnAP.Text = "─"
    minimizeBtnAP.TextColor3 = Color3.fromRGB(255, 255, 255)
    minimizeBtnAP.Font = Enum.Font.GothamBold
    minimizeBtnAP.TextSize = 26
    minimizeBtnAP.Parent = frameAP

    local closeBtnAP = Instance.new("TextButton")
    closeBtnAP.Size = UDim2.new(0, 50, 0, 45)
    closeBtnAP.Position = UDim2.new(0.88, 0, 0.005, 0)
    closeBtnAP.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
    closeBtnAP.Text = "✕"
    closeBtnAP.TextColor3 = Color3.fromRGB(255, 255, 255)
    closeBtnAP.Font = Enum.Font.GothamBold
    closeBtnAP.TextSize = 24
    closeBtnAP.Parent = frameAP
    closeBtnAP.Activated:Connect(function()
        if afkConnectionAP then
            afkConnectionAP:Disconnect()
            afkConnectionAP = nil
        end
        screenGuiAP:Destroy()
    end)

    local minimizedAP = false
    local contentAP = Instance.new("Frame")
    contentAP.Size = UDim2.new(1, 0, 1, -60)
    contentAP.Position = UDim2.new(0, 0, 0.08, 0)
    contentAP.BackgroundTransparency = 1
    contentAP.Parent = frameAP

    minimizeBtnAP.Activated:Connect(function()
        minimizedAP = not minimizedAP
        contentAP.Visible = not minimizedAP
        if minimizedAP then
            frameAP.Size = UDim2.new(0, 600, 0, 60)
            minimizeBtnAP.Text = "□"
            frameAP.Position = UDim2.new(0.5, -300, 0.5, -30)
        else
            frameAP.Size = UDim2.new(0, 600, 0, 850)
            minimizeBtnAP.Text = "─"
            frameAP.Position = UDim2.new(0.5, -300, 0.5, -425)
        end
    end)

    local afkFrameAP = Instance.new("Frame")
    afkFrameAP.Size = UDim2.new(1, 0, 0, 50)
    afkFrameAP.Position = UDim2.new(0, 0, 0, 0)
    afkFrameAP.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
    afkFrameAP.BackgroundTransparency = 0.3
    afkFrameAP.Parent = contentAP

    local afkLabelAP = Instance.new("TextLabel")
    afkLabelAP.Size = UDim2.new(0.4, 0, 1, 0)
    afkLabelAP.BackgroundTransparency = 1
    afkLabelAP.Text = "AFK Space Key"
    afkLabelAP.TextColor3 = Color3.fromRGB(255, 255, 255)
    afkLabelAP.TextSize = 18
    afkLabelAP.Font = Enum.Font.GothamBold
    afkLabelAP.TextXAlignment = Enum.TextXAlignment.Left
    afkLabelAP.Parent = afkFrameAP

    local afkStatusAP = Instance.new("TextLabel")
    afkStatusAP.Size = UDim2.new(0.3, 0, 1, 0)
    afkStatusAP.Position = UDim2.new(0.4, 0, 0, 0)
    afkStatusAP.BackgroundTransparency = 1
    afkStatusAP.Text = "🔴 OFF"
    afkStatusAP.TextColor3 = Color3.fromRGB(255, 100, 100)
    afkStatusAP.TextSize = 16
    afkStatusAP.Font = Enum.Font.GothamBold
    afkStatusAP.Parent = afkFrameAP

    local afkBtnAP = Instance.new("TextButton")
    afkBtnAP.Size = UDim2.new(0.15, 0, 0.7, 0)
    afkBtnAP.Position = UDim2.new(0.75, 0, 0.15, 0)
    afkBtnAP.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
    afkBtnAP.Text = "ON"
    afkBtnAP.TextColor3 = Color3.fromRGB(255, 255, 255)
    afkBtnAP.Font = Enum.Font.GothamBold
    afkBtnAP.TextSize = 16
    afkBtnAP.Parent = afkFrameAP

    local scrollAP = Instance.new("ScrollingFrame")
    scrollAP.Size = UDim2.new(1, 0, 1, -55)
    scrollAP.Position = UDim2.new(0, 0, 0.07, 0)
    scrollAP.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
    scrollAP.BackgroundTransparency = 0.3
    scrollAP.Parent = contentAP
    scrollAP.CanvasSize = UDim2.new(0, 0, 0, 0)
    scrollAP.ScrollBarThickness = 8
    scrollAP.BottomImage = "rbxasset://textures/ui/Scroll/scroll-bottom.png"
    scrollAP.MidImage = "rbxasset://textures/ui/Scroll/scroll-middle.png"
    scrollAP.TopImage = "rbxasset://textures/ui/Scroll/scroll-top.png"

    local layoutAP = Instance.new("UIListLayout")
    layoutAP.Padding = UDim.new(0, 8)
    layoutAP.SortOrder = Enum.SortOrder.LayoutOrder
    layoutAP.Parent = scrollAP

    local function updateCanvasAP()
        local totalHeight = 0
        for _, child in ipairs(scrollAP:GetChildren()) do
            if child:IsA("Frame") and child ~= layoutAP then
                totalHeight = totalHeight + child.Size.Y.Offset + 8
            end
        end
        scrollAP.CanvasSize = UDim2.new(0, 0, 0, totalHeight + 120)
    end

    local itemStatesAP = {}
    local afkEnabledAP = false
    local afkConnectionAP = nil

    local function purchaseItemAP(index)
        local item = itemsAP[index]
        local remote = remotesAP[index]
        local success, result = pcall(function()
            return remote:InvokeServer(unpack(item.args))
        end)
        if success then
            itemStatesAP[index].count = itemStatesAP[index].count + 1
            itemStatesAP[index].countLabel.Text = "Purchased: " .. itemStatesAP[index].count .. "x"
            print("✅ " .. item.name .. " purchased! (Total: " .. itemStatesAP[index].count .. ")")
            return true
        else
            print("❌ " .. item.name .. " failed: " .. tostring(result))
            return false
        end
    end

    local function itemLoopAP(index)
        while itemStatesAP[index].enabled do
            purchaseItemAP(index)
            task.wait(itemStatesAP[index].interval)
        end
        itemStatesAP[index].toggleBtn.Text = "off"
        itemStatesAP[index].toggleBtn.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
    end

    local function startAFKAP()
        if afkConnectionAP then
            afkConnectionAP:Disconnect()
            afkConnectionAP = nil
        end
        local VirtualInputManager = game:GetService("VirtualInputManager")
        afkStatusAP.Text = "🟢 ON"
        afkStatusAP.TextColor3 = Color3.fromRGB(100, 255, 100)
        afkBtnAP.Text = "OFF"
        afkBtnAP.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
        afkEnabledAP = true
        afkConnectionAP = game:GetService("RunService").Heartbeat:Connect(function()
            if afkEnabledAP then
                VirtualInputManager:SendKeyEvent(true, "Space", false, game)
                task.wait(0.2)
                VirtualInputManager:SendKeyEvent(false, "Space", false, game)
                task.wait(300)
            end
        end)
        print("🔄 AFK Space Key started (5min interval)")
    end

    local function stopAFKAP()
        if afkConnectionAP then
            afkConnectionAP:Disconnect()
            afkConnectionAP = nil
        end
        afkEnabledAP = false
        afkStatusAP.Text = "🔴 OFF"
        afkStatusAP.TextColor3 = Color3.fromRGB(255, 100, 100)
        afkBtnAP.Text = "ON"
        afkBtnAP.BackgroundColor3 = Color3.fromRGB(0, 200, 0)
        print("⏹ AFK Space Key stopped")
    end

    afkBtnAP.Activated:Connect(function()
        if afkEnabledAP then
            stopAFKAP()
        else
            startAFKAP()
        end
    end)

    for i, item in ipairs(itemsAP) do
        local row = Instance.new("Frame")
        row.Size = UDim2.new(1, -10, 0, 90)
        row.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
        row.BackgroundTransparency = 0.2
        row.Parent = scrollAP

        local nameLabel = Instance.new("TextLabel")
        nameLabel.Size = UDim2.new(1, 0, 0, 28)
        nameLabel.BackgroundTransparency = 1
        nameLabel.Text = item.name
        nameLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
        nameLabel.TextSize = 18
        nameLabel.Font = Enum.Font.GothamBold
        nameLabel.TextXAlignment = Enum.TextXAlignment.Left
        nameLabel.Parent = row

        local intervalLabel = Instance.new("TextLabel")
        intervalLabel.Size = UDim2.new(0.2, 0, 0.3, 0)
        intervalLabel.Position = UDim2.new(0, 0, 0.38, 0)
        intervalLabel.BackgroundTransparency = 1
        intervalLabel.Text = "Interval (sec):"
        intervalLabel.TextColor3 = Color3.fromRGB(200, 200, 200)
        intervalLabel.TextSize = 14
        intervalLabel.Font = Enum.Font.Gotham
        intervalLabel.TextXAlignment = Enum.TextXAlignment.Left
        intervalLabel.Parent = row

        local intervalBox = Instance.new("TextBox")
        intervalBox.Size = UDim2.new(0.15, 0, 0.3, 0)
        intervalBox.Position = UDim2.new(0.2, 0, 0.38, 0)
        intervalBox.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
        intervalBox.Text = "2"
        intervalBox.TextColor3 = Color3.fromRGB(255, 255, 255)
        intervalBox.Font = Enum.Font.Gotham
        intervalBox.TextSize = 16
        intervalBox.PlaceholderText = "sec"
        intervalBox.Parent = row

        local toggleBtn = Instance.new("TextButton")
        toggleBtn.Size = UDim2.new(0.18, 0, 0.35, 0)
        toggleBtn.Position = UDim2.new(0.75, 0, 0.35, 0)
        toggleBtn.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
        toggleBtn.Text = "off"
        toggleBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
        toggleBtn.Font = Enum.Font.GothamBold
        toggleBtn.TextSize = 18
        toggleBtn.Parent = row

        local countLabel = Instance.new("TextLabel")
        countLabel.Size = UDim2.new(1, 0, 0.25, 0)
        countLabel.Position = UDim2.new(0, 0, 0.72, 0)
        countLabel.BackgroundTransparency = 1
        countLabel.Text = "Purchased: 0x"
        countLabel.TextColor3 = Color3.fromRGB(200, 200, 200)
        countLabel.TextSize = 15
        countLabel.Font = Enum.Font.Gotham
        countLabel.TextXAlignment = Enum.TextXAlignment.Left
        countLabel.Parent = row

        itemStatesAP[i] = {
            enabled = false,
            count = 0,
            interval = 2,
            toggleBtn = toggleBtn,
            countLabel = countLabel,
        }

        toggleBtn.Activated:Connect(function()
            itemStatesAP[i].enabled = not itemStatesAP[i].enabled
            toggleBtn.Text = itemStatesAP[i].enabled and "ON" or "off"
            toggleBtn.BackgroundColor3 = itemStatesAP[i].enabled and Color3.fromRGB(0, 200, 0) or Color3.fromRGB(200, 50, 50)
            if itemStatesAP[i].enabled then
                itemStatesAP[i].count = 0
                itemStatesAP[i].interval = tonumber(intervalBox.Text) or 2
                countLabel.Text = "Purchased: 0x"
                print("▶️ " .. item.name .. " started! Interval: " .. itemStatesAP[i].interval .. "s")
                coroutine.wrap(itemLoopAP)(i)
            else
                print("⏹️ " .. item.name .. " stopped")
            end
        end)
    end

    task.wait(0.1)
    updateCanvasAP()
    layoutAP:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(updateCanvasAP)

    print("✅ Auto Purchase + AFK GUI loaded!")
    print("📊 Items: " .. #itemsAP .. " types")
end

--========================================================
-- START
--========================================================
main.Visible = true
farmPanel.Visible = false
print("✅ SLEEPY X ASVARA (全機能統合版 + AutoPurchase) Loaded")
